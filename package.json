{
  "name": "loop",
  "private": true,
  "description": "LOOP:一个 Project 就是一个长期运行的 Agent",
  "scripts": {
    "api:dev": "npm --prefix apps/api run dev",
    "api:test": "npm --prefix apps/api run test",
    "api:typecheck": "npm --prefix apps/api run typecheck",
    "api:migrate": "npm --prefix apps/api run migrate",
    "api:seed": "npm --prefix apps/api run seed",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "install:all": "npm --prefix apps/api install && npm --prefix apps/web install"
  }
}
