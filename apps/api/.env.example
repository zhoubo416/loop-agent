# 后端服务
PORT=4000
HOST=127.0.0.1

# 数据库:正式环境用真实 PostgreSQL,留空时回落到内嵌 PGlite(数据落在 .data/pglite)
# 例如 postgres://user:password@host:5432/loop
DATABASE_URL=
PGDATA_DIR=.data/pglite

# Agent Engine:只连真实服务,走 OpenAI 兼容的 Chat Completions 接口
AGENT_ENGINE=pi
AGENT_ENGINE_BASE_URL=https://api.deepseek.com
AGENT_ENGINE_API_KEY=
AGENT_ENGINE_MODEL=deepseek-chat
AGENT_ENGINE_TIMEOUT_MS=120000
AGENT_ENGINE_MAX_RETRIES=2

# Worker
WORKER_ENABLED=true
WORKER_INTERVAL_MS=1000
SCHEDULER_INTERVAL_MS=10000

# 开发用身份:未携带 X-User-Id 时使用的默认用户
DEV_USER_EMAIL=dev@loop.local
