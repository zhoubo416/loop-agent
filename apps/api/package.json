{
  "name": "@loop/api",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "LOOP Backend API 与 Agent Runtime",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx src/index.ts",
    "migrate": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
